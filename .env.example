APP_ENV=development
# Enable only after applying the PDF workflow migration. Experimental static PDFs.
PDF_ENABLED=false
APP_NAME=StegaShield Gateway
API_V1_PREFIX=/api/v1
MAX_UPLOAD_SIZE_BYTES=10485760
WATERMARK_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
